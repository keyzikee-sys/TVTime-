<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Base Translucent Glass Surface Fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#331A0B19"
                android:centerColor="#1F0B0019"
                android:endColor="#2B120022"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 2: Top Edge Specular Light Refraction (Glass Glare) -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="160dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Glass Border Rim with Pink Specular Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66FF00A6" />
            <solid android:color="#00000000" />
        </shape>
    </item>

</layer-list>
