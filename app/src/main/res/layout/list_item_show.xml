<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/glass_item_selector">

    <!-- Poster -->
    <ImageView
        android:id="@+id/iv_show_poster"
        android:layout_width="72dp"
        android:layout_height="104dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:background="#1AFFFFFF"
        android:contentDescription="Show poster" />

    <!-- Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_show_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF00A6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_show_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#FF00A6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="✕"
                android:textColor="#FF5252"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Remove item" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_show_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#AEB6C2"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_show_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#D6D9E0"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/pb_show_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="9dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF00A6"
            android:backgroundTint="#33333A" />

    </LinearLayout>

</LinearLayout>
