<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0019"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget Customization"
            android:textColor="#FFFF13"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Preview"
            android:textColor="#FF00A6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Live Preview Card -->
        <FrameLayout
            android:id="@+id/preview_card_container"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TVTime Live Widget"
                    android:textColor="#FF00A6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/preview_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glassmorphism Preview Card"
                    android:textColor="#AEB6C2"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget Title"
            android:textColor="#FFFF13"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/widget_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter widget title"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899A6"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:layout_marginBottom="20dp" />

        <!-- System Dynamic Color Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Use System Dynamic Color"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dynamic_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Glass Presets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glass Presets"
            android:textColor="#FFFF13"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <RadioGroup
            android:id="@+id/rg_glass_presets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rb_frosted_glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frosted Glass (Light)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="#FFFF13" />

            <RadioButton
                android:id="@+id/rb_dark_obsidian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dark Obsidian Glass"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="#FFFF13" />

            <RadioButton
                android:id="@+id/rb_tinted_neon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tinted Neon Glass"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="#FFFF13" />

            <RadioButton
                android:id="@+id/rb_liquid_blur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liquid Blur Glass"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="#FFFF13" />

            <RadioButton
                android:id="@+id/rb_liquid_no_blur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liquid Glass (No Blur)"
                android:textColor="#FF00A6"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="#FFFF13" />
        </RadioGroup>

        <!-- Colors Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colors, Fonts &amp; Hex Codes"
            android:textColor="#FFFF13"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Font Color Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_font_color"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#FF00A6"
                android:text="🔤 FONT / TEXT COLOR"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <View
                android:id="@+id/preview_font_box"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="#FF00A6" />
        </LinearLayout>

        <!-- Accent Color Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_accent_color"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFF13"
                android:text="🎨 ACCENT COLOR"
                android:textColor="#000000"
                android:textStyle="bold" />

            <View
                android:id="@+id/preview_accent_box"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="#FFFF13" />
        </LinearLayout>

        <!-- Stroke Color Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_stroke_color"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#008080"
                android:text="✏️ STROKE (BORDER) COLOR"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <View
                android:id="@+id/preview_stroke_box"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="#008080" />
        </LinearLayout>

        <!-- Background Color Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btn_bg_color"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#201C33"
                android:text="⬛ BACKGROUND COLOR (HEX)"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <View
                android:id="@+id/preview_bg_box"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="#1B162E" />
        </LinearLayout>

        <!-- Content Source -->
        <Button
            android:id="@+id/btn_content_source"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#201C33"
            android:text="CONTENT SOURCE"
            android:textColor="#FFFF13"
            android:textStyle="bold" />

        <!-- Blur Options Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blur Options"
            android:textColor="#FFFF13"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable Background Blur"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_enable_blur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_blur_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blur Radius / Intensity: 15dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_blur_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="15"
            android:progressTint="#FFFF13"
            android:thumbTint="#FFFF13"
            android:layout_marginBottom="20dp" />

        <!-- Stroke Thickness -->
        <TextView
            android:id="@+id/tv_stroke_thickness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stroke Thickness: 2dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_stroke_thickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="2"
            android:progressTint="#FFFF13"
            android:thumbTint="#FFFF13"
            android:layout_marginBottom="16dp" />

        <!-- Corner Radius -->
        <TextView
            android:id="@+id/tv_corner_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Corner Radius: 28dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_corner_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="28"
            android:progressTint="#FFFF13"
            android:thumbTint="#FFFF13"
            android:layout_marginBottom="16dp" />

        <!-- Background Opacity -->
        <TextView
            android:id="@+id/tv_bg_opacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Background Opacity / Alpha: 80%"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sb_bg_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80"
            android:progressTint="#FFFF13"
            android:thumbTint="#FFFF13"
            android:layout_marginBottom="24dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_config"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#FFFF13"
            android:text="SAVE WIDGET CONFIGURATION"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
