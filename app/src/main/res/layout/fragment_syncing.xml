<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0019"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tubi Account"
            android:textColor="#FFFF13"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_tubi_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tubi email"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF"
            android:background="#22FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_tubi_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tubi password"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF"
            android:background="#22FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_tubi_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign in to Tubi"
            android:textColor="#0B0019"
            android:textStyle="bold"
            android:backgroundTint="#FFFF13"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_tubi_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not signed in"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_tubi_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync my Tubi (continue-watching + my list)"
            android:textColor="#0B0019"
            android:textStyle="bold"
            android:backgroundTint="#FF00A6"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_tubi_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
