<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_tab_watchlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="WatchList"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true" />

            <TextView
                android:id="@+id/tv_tab_mystuff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My Stuff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/widget_page_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <GridView
                    android:id="@+id/grid_watchlist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:numColumns="2"
                    android:verticalSpacing="6dp"
                    android:horizontalSpacing="6dp"
                    android:stretchMode="spacingWidth"
                    android:scrollbars="none"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_empty_p1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="No shows yet — add in the app"
                    android:textColor="#B8C0CC"
                    android:textSize="12sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_page_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <GridView
                    android:id="@+id/grid_mystuff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:numColumns="2"
                    android:verticalSpacing="6dp"
                    android:horizontalSpacing="6dp"
                    android:stretchMode="spacingWidth"
                    android:scrollbars="none"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_empty_p2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Nothing saved yet — add in the app"
                    android:textColor="#B8C0CC"
                    android:textSize="12sp" />
            </FrameLayout>
        </ViewFlipper>
    </LinearLayout>
</FrameLayout>
