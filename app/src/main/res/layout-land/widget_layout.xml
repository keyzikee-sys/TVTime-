<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="8dp">

    <ImageView
        android:id="@+id/iv_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Stuff"
            android:textColor="#FF00A6"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <FrameLayout
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="#3314141C"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_hero_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UP NEXT"
                    android:textColor="#FF00A6"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FF00A6"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_hero_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#AEB6C2"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_hero_progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Progress: 0%"
                    android:textColor="#AEB6C2"
                    android:textSize="10sp" />
                <ProgressBar
                    android:id="@+id/pb_hero_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FFFF13"
                    android:backgroundTint="#333A44" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:id="@+id/widget_page_controls" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center">
            <Button android:id="@+id/btn_page_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="MY STUFF" android:textSize="11sp" android:textColor="#FF00A6" android:backgroundTint="#402033" />
            <Button android:id="@+id/btn_page_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="TERROR" android:textSize="11sp" android:textColor="#FFFF13" android:backgroundTint="#202F33" />
        </LinearLayout>
        <ListView
            android:id="@+id/list_mystuff"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:scrollbars="none" />

    </LinearLayout>
</FrameLayout>
